<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal">
  <head>
    <metadata>
      <ttm:agent type="person" xml:id="v1"/>
      <ttm:agent type="other" xml:id="v2"/>
    </metadata>
  </head>
  <body dur="03:00.000">
    <div>
      <!-- A background whose wrapper carries its own times, with a translation
           nested inside it: the shape the real AMLL database writes. -->
      <p begin="00:10.000" end="00:14.000" ttm:agent="v1" itunes:key="L1"><span begin="00:10.000" end="00:11.000">Flashing</span> <span begin="00:11.000" end="00:14.000">Lights</span><span ttm:role="x-bg" begin="00:11.500" end="00:13.500"><span begin="00:11.500" end="00:13.500">(Know)</span><span ttm:role="x-translation" xml:lang="zh-CN">知道</span></span><span ttm:role="x-translation" xml:lang="zh-CN">灯光闪烁</span></p>
      <!-- A background wrapper with no times of its own: they have to come from
           its spans. -->
      <p begin="00:20.000" end="00:24.000" ttm:agent="v1" itunes:key="L2"><span begin="00:20.000" end="00:24.000">Second line</span><span ttm:role="x-bg"><span begin="00:21.000" end="00:22.000">(ooh)</span></span><span ttm:role="x-translation" xml:lang="zh-CN">第二行</span></p>
      <!-- A background that comes in AFTER the next line has started. Sorting by
           time alone would hang it on the wrong line; the parent pointer does not. -->
      <p begin="00:30.000" end="00:36.000" ttm:agent="v1" itunes:key="L3"><span begin="00:30.000" end="00:36.000">Long third line</span><span ttm:role="x-bg" begin="00:34.000" end="00:35.000"><span begin="00:34.000" end="00:35.000">(late)</span></span></p>
      <p begin="00:33.000" end="00:37.000" ttm:agent="v2" itunes:key="L4"><span begin="00:33.000" end="00:37.000">Fourth line</span><span ttm:role="x-translation" xml:lang="zh-CN">第四行</span></p>
      <!-- A real duet: 2.5 s of overlap, well over half the shorter phrase. -->
      <p begin="00:40.000" end="00:46.000" ttm:agent="v1" itunes:key="L5"><span begin="00:40.000" end="00:46.000">I will always love you</span></p>
      <p begin="00:43.500" end="00:48.000" ttm:agent="v2" itunes:key="L6"><span begin="00:43.500" end="00:48.000">And I will always need you</span></p>
      <!-- A quarter-second overlap: one phrase's tail bleeding into the next,
           which is the median case in the database and is not a duet. -->
      <p begin="00:50.000" end="00:54.250" ttm:agent="v1" itunes:key="L7"><span begin="00:50.000" end="00:54.250">Slop before</span></p>
      <p begin="00:54.000" end="00:58.000" ttm:agent="v1" itunes:key="L8"><span begin="00:54.000" end="00:58.000">Slop after</span></p>
    </div>
  </body>
</tt>
