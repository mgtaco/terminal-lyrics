# Maintainer: mgtaco <https://github.com/mgtaco>
#
# The prebuilt binary from the GitHub release, so installing needs no Rust
# toolchain. `terminal-lyrics-git` builds from source instead.
pkgname=terminal-lyrics-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="Giant block lyrics in your terminal, synced to whatever is playing"
arch=('x86_64')
url="https://github.com/mgtaco/terminal-lyrics"
license=('MIT')
# The release binary links only the C runtime; everything else, TLS included,
# is static.
depends=('gcc-libs')
provides=('terminal-lyrics')
conflicts=('terminal-lyrics' 'terminal-lyrics-git')
options=('!strip')
_dist="lyrics-${pkgver}-x86_64-unknown-linux-gnu"
source=("${_dist}.tar.gz::${url}/releases/download/v${pkgver}/${_dist}.tar.gz")
# GitHub's own digest for the release asset. `pkgver` and this are set by the
# release workflow once the archives are up, so neither is bumped by hand.
sha256sums=('6f698e429453df40cf26e83b923e70779dac9065bb1d9315d09f8d164ecdfb22')

package() {
    cd "${_dist}"
    install -Dm755 lyrics "${pkgdir}/usr/bin/lyrics"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 config.example.toml \
        "${pkgdir}/usr/share/doc/${pkgname}/config.example.toml"
}
